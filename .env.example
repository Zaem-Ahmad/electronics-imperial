# demo: use the exact cooker fixture. database: query Supabase with Prisma.
CATALOG_SOURCE=demo
# Runtime: Supabase transaction pooler (6543) for serverless deployments.
DATABASE_URL=
# Migrations/seed: Supabase session pooler (5432), or direct IPv6 connection.
DIRECT_URL=
# WhatsApp ordering number is configured in src/lib/site-config.ts.
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/
NEXT_PUBLIC_CONTACT_LOCATION=Karachi, Pakistan
NEXT_PUBLIC_CONTACT_DETAILS_READY=false
# Optional override; Vercel production domain is detected automatically.
SITE_URL=

# Set false on staging or preview deployments, even when SITE_URL is configured.
SITE_INDEXABLE=true
# Optional Google Search Console HTML verification token (not the full tag).
GOOGLE_SITE_VERIFICATION=
